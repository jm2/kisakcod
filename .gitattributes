# CI helper scripts must keep POSIX line endings or bash on Windows runners
# fails with '\r: command not found'.
scripts/ci/*.sh text eol=lf

# The vendored Speex snapshot (src/groupvoice/speex/) and the deps/speex
# public surface are committed with LF endings and must stay byte-identical
# to upstream Speex 1.1.9, so checkout-time eol rewriting is disabled for
# exactly those surfaces.
src/groupvoice/speex/** -text
deps/speex/** -text
