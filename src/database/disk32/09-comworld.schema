# ComWorld, asset type 0x0C, and the primary lights it holds. The format is
# described in ../db_disk32.schema.

record ComPrimaryLight 0x44 runtime=ComPrimaryLight header=xanim/xanim.h
    0x00 type               u8
    0x01 canUseShadowMap    u8
    0x02 exponent           u8
    0x03 unused             u8
    0x04 color              f32[3]
    0x10 dir                f32[3]
    0x1C origin             f32[3]
    0x28 radius             f32
    0x2C cosHalfFovOuter    f32
    0x30 cosHalfFovInner    f32
    0x34 cosHalfFovExpanded f32
    0x38 rotationLimit      f32
    0x3C translationLimit   f32
    0x40 defName            xstring

record ComWorld 0x10 runtime=ComWorld header=xanim/xanim.h
    asset member=comWorld pool=Load_ComWorldAsset kind=ComWorld alias=inserted name=name label=com-world
    0x00 name              xstring
    0x04 isInUse           i32
    0x08 primaryLightCount u32
    0x0C primaryLights     array of=ComPrimaryLight count=primaryLightCount label=primary-light
