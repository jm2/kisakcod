# TechniqueSet (MaterialTechniqueSet), asset type 0x05, and the records its
# techniques hold. The format is described in ../db_disk32.schema. The body
# is custom (db_disk32_techniqueset.cpp): techniques, vertex declarations and
# shaders are completed objects, and a technique's passes follow its header.

# The routing table: 16 source/dest byte pairs, then 16 runtime declaration
# handles whose disk bytes are no tokens.
record MaterialVertexStreamRouting 0x60 runtime=MaterialVertexStreamRouting header=gfx_d3d/r_material.h
    0x00 data                   u8[32]
    0x20 decl                   pointer[16]

record MaterialVertexDeclaration 0x64 runtime=MaterialVertexDeclaration header=gfx_d3d/r_material.h
    0x00 streamCount            u8
    0x01 hasOptionalSource      bool
    0x02 isLoaded               bool
    0x04 routing                struct   of=MaterialVertexStreamRouting

# A shader: its name, the runtime handle (no token) and its load definition,
# whose program DWORDs follow it in block 4.
record MaterialVertexShader 0x10 runtime=MaterialVertexShader header=gfx_d3d/r_material.h
    0x00 name                   xstring
    0x04 prog.vs                rawptr
    0x08 prog.loadDef.program   pointer
    0x0C prog.loadDef.programSize     u16
    0x0E prog.loadDef.loadForRenderer u16

record MaterialPixelShader 0x10 runtime=MaterialPixelShader header=gfx_d3d/r_material.h
    0x00 name                   xstring
    0x04 prog.ps                rawptr
    0x08 prog.loadDef.program   pointer
    0x0C prog.loadDef.programSize     u16
    0x0E prog.loadDef.loadForRenderer u16

# A shader argument: a literal constant's token (types 1 and 7), else the code
# constant, code sampler or name hash in the union's first four bytes.
record MaterialShaderArgument 0x08 runtime=MaterialShaderArgument header=gfx_d3d/r_material.h copy=scalars
    0x00 type                   u16
    0x02 dest                   u16
    0x04 u.literalConst         pointer

record MaterialPass 0x14 runtime=MaterialPass header=gfx_d3d/r_material.h copy=scalars
    0x00 vertexDecl             pointer  # MaterialVertexDeclaration
    0x04 vertexShader           pointer  # MaterialVertexShader
    0x08 pixelShader            pointer  # MaterialPixelShader
    0x0C perPrimArgCount        u8
    0x0D perObjArgCount         u8
    0x0E stableArgCount         u8
    0x0F customSamplerFlags     u8
    0x10 args                   pointer  # MaterialShaderArgument

# The header, then passCount passes (1 to 4) where passArray[0] sits.
record MaterialTechnique 0x1C runtime=MaterialTechnique header=gfx_d3d/r_material.h
    0x00 name                   xstring
    0x04 flags                  u16
    0x06 passCount              u16
    0x08 passArray              struct   of=MaterialPass

record MaterialTechniqueSet 0x94 runtime=MaterialTechniqueSet header=gfx_d3d/r_material.h copy=scalars
    asset member=techniqueSet pool=Load_MaterialTechniqueSetAsset kind=MaterialTechniqueSet alias=inserted body=custom label=technique-set
    0x00 name                   xstring
    0x04 worldVertFormat        u8
    0x05 hasBeenUploaded        bool
    0x06 unused                 u8[1]
    0x08 remappedTechniqueSet   rawptr
    0x0C techniques             pointer[34]  # MaterialTechnique
