# ClipMap (clipMap_t), asset types 0x0A and 0x0B (ClipMapPvs): a 284-byte
# record that grows to 480 bytes natively. The format is described in
# ../db_disk32.schema. The body is custom (db_disk32_clipmap.cpp): arrays
# that hold no pointer keep their layout and stay in block 4, and the dynamic
# entities' poses, clients and collision links take block 1 (zero-filled).

# A static model: its model loads through XModel's step.
record cStaticModel_s 0x50 runtime=cStaticModel_s header=xanim/xanim.h copy=scalars
    0x00 writable.nextModelInWorldSector  u16
    0x02 xmodelPad                pad[2]
    0x04 xmodel                   pointer
    0x08 origin                   run[18]   to=absmax

# A node: its plane is a token, -1 streaming it here.
record cNode_t 0x08 runtime=cNode_t header=xanim/xanim.h copy=scalars
    0x00 plane                    pointer
    0x04 children                 i16[2]

# A leaf-brush node: with brushes, data is a leaf naming leafBrushCount
# brush indices; without, it is children, copied whole.
record cLeafBrushNode_s 0x14 runtime=cLeafBrushNode_s header=xanim/xanim.h copy=scalars
    0x00 axis                     u8
    0x01 axisPad                  pad[1]
    0x02 leafBrushCount           i16
    0x04 contents                 i32
    0x08 data.leaf.brushes        pointer
    0x0C dataTail                 pad[8]

# A partition: its borders hold no pointer.
record CollisionPartition 0x0C runtime=CollisionPartition header=xanim/xanim.h copy=scalars
    0x00 triCount                 u8
    0x01 borderCount              u8
    0x02 firstTriPad              pad[2]
    0x04 firstTri                 i32
    0x08 borders                  pointer

# A brush: its sides and adjacency name the clip map's brush sides and brush
# edges by offset.
record cbrush_t 0x50 runtime=cbrush_t header=xanim/xanim.h copy=scalars
    0x00 mins                     f32[3]
    0x0C contents                 i32
    0x10 maxs                     f32[3]
    0x1C numsides                 u32
    0x20 sides                    pointer
    0x24 axialMaterialNum         i16[2][3]
    0x30 baseAdjacentSide         pointer
    0x34 firstAdjacentSideOffsets i16[2][3]
    0x40 edgeCount                u8[2][3]
    0x46 edgeCountPad             pad[10]

# A model piece: its model loads through XModel's step.
record XModelPiece 0x10 runtime=XModelPiece header=xanim/xmodel.h copy=scalars
    0x00 model                    pointer
    0x04 offset                   f32[3]

# Model pieces, a completed object only dynamic-entity defs name.
record XModelPieces 0x0C runtime=XModelPieces header=xanim/xmodel.h copy=scalars
    0x00 name                     xstring
    0x04 numpieces                i32
    0x08 pieces                   pointer  # numpieces pieces, inline

# A dynamic-entity def: its model, effect and physics preset load through
# their families' steps; its destroy pieces are model pieces.
record DynEntityDef 0x60 runtime=DynEntityDef header=DynEntity/DynEntity_client.h copy=scalars
    0x00 type                     run[8]    to=pose
    0x20 xModel                   pointer
    0x24 brushModel               u16
    0x26 physicsBrushModel        u16
    0x28 destroyFx                pointer
    0x2C destroyPieces            pointer
    0x30 physPreset               pointer
    0x34 health                   run[11]   to=contents

record clipMap_t 0x11C runtime=clipMap_t header=qcommon/qcommon.h copy=scalars
    asset member=clipMap pool=Load_ClipMapAsset kind=ClipMap alias=inserted body=custom label=clipmap
    0x000 name                   xstring
    0x004 isInUse                i32
    0x008 planeCount             i32
    0x00C planes                 pointer   # planeCount 20-byte planes
    0x010 numStaticModels        u32
    0x014 staticModelList        pointer   # 80-byte static models, each naming a model
    0x018 numMaterials           u32
    0x01C materials              pointer   # 72-byte materials
    0x020 numBrushSides          u32
    0x024 brushsides             pointer   # 12-byte sides, each naming a plane
    0x028 numBrushEdges          u32
    0x02C brushEdges             pointer   # bytes
    0x030 numNodes               u32
    0x034 nodes                  pointer   # 8-byte nodes, each naming a plane
    0x038 numLeafs               u32
    0x03C leafs                  pointer   # 44-byte leafs
    0x040 leafbrushNodesCount    u32
    0x044 leafbrushNodes         pointer   # 20-byte nodes, a leaf naming its brush indices
    0x048 numLeafBrushes         u32
    0x04C leafbrushes            pointer   # 16-bit brush indices
    0x050 numLeafSurfaces        u32
    0x054 leafsurfaces           pointer   # 32-bit surface indices
    0x058 vertCount              u32
    0x05C verts                  pointer   # 12-byte vertices
    0x060 triCount               i32
    0x064 triIndices             pointer   # 3 x triCount 16-bit indices
    0x068 triEdgeIsWalkable      pointer   # a bit per index, in 32-bit words
    0x06C borderCount            i32
    0x070 borders                pointer   # 28-byte borders
    0x074 partitionCount         i32
    0x078 partitions             pointer   # 12-byte partitions, each naming borders
    0x07C aabbTreeCount          i32
    0x080 aabbTrees              pointer   # 32-byte trees
    0x084 numSubModels           u32
    0x088 cmodels                pointer   # 72-byte models
    0x08C numBrushes             u16
    0x08E numBrushesPad          pad[2]
    0x090 brushes                pointer   # 80-byte brushes, 16-aligned
    0x094 numClusters            i32
    0x098 clusterBytes           i32
    0x09C visibility             pointer   # numClusters x clusterBytes bytes
    0x0A0 vised                  i32
    0x0A4 mapEnts                pointer   # MapEnts
    0x0A8 box_brush              pointer   # a brush, a completed object
    0x0AC box_model              run[18]   to=box_model
    0x0F4 dynEntCount            u16[2]
    0x0F8 dynEntDefList          pointer[2]  # 96-byte entity defs
    0x100 dynEntPoseList         pointer[2]  # 32-byte poses, block 1
    0x108 dynEntClientList       pointer[2]  # 12-byte clients, block 1
    0x110 dynEntCollList         pointer[2]  # 20-byte collision links, block 1
    0x118 checksum               u32
