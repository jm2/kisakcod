# Image (GfxImage), asset type 0x06. The format is described in ../db_disk32.schema.

# The pixels a texture token streams (Load_GfxImageLoadDef): the 16-byte header,
# then resourceSize bytes from `data` on. It holds no pointer, so both widths
# share its layout.
record GfxImageLoadDef 0x14 runtime=GfxImageLoadDef header=gfx_d3d/r_gfx.h
    0x00 levelCount      u8
    0x01 flags           u8
    0x02 dimensions      i16      count=3
    0x08 format          i32
    0x0C resourceSize    i32
    0x10 data            u8       count=4

# The body is custom (db_disk32_image.cpp): the name streams before the
# texture, and the texture is a GfxImageLoadDef token.
record GfxImage 0x24 runtime=GfxImage header=gfx_d3d/r_gfx.h
    asset member=image pool=Load_GfxImageAsset kind=GfxImage alias=inserted body=custom label=image
    0x00 mapType         i32
    0x04 texture         pointer
    0x08 picmip          u8       count=2
    0x0A noPicmip        bool
    0x0B semantic        u8
    0x0C track           u8
    0x10 cardMemory      i32      count=2
    0x18 width           u16
    0x1A height          u16
    0x1C depth           u16
    0x1E category        u8
    0x1F delayLoadPixels bool
    0x20 name            xstring
