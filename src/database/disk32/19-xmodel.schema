# XModel, asset type 0x03, and the LOD records it holds inline. The format is
# described in ../db_disk32.schema. The body is custom (db_disk32_xmodel.cpp):
# the bone arrays keep their layout and stay in block 4, and the model's rules
# are DB_ValidateXModelGraph's (db_xmodel_validation.h).

record XModelLodInfo 0x1C runtime=XModelLodInfo header=xanim/xmodel.h copy=scalars
    0x00 dist                 f32
    0x04 numsurfs             u16
    0x06 surfIndex            u16
    0x08 partBits             i32[4]
    0x18 lod                  u8
    0x19 smcIndexPlusOne      u8
    0x1A smcAllocBits         u8
    0x1B unused               u8

# A rigid-vertex list's collision tree: its nodes (16-aligned) and leaves
# keep their layout and follow it in block 4.
record XSurfaceCollisionTree 0x28 runtime=XSurfaceCollisionTree header=xanim/xanim.h copy=scalars
    0x00 trans                f32[3]
    0x0C scale                f32[3]
    0x18 nodeCount            u32
    0x1C nodes                pointer
    0x20 leafCount            u32
    0x24 leafs                pointer

record XRigidVertList 0x0C runtime=XRigidVertList header=xanim/xanim.h copy=scalars
    0x00 boneOffset           u16
    0x02 vertCount            u16
    0x04 triOffset            u16
    0x06 triCount             u16
    0x08 collisionTree        pointer  # XSurfaceCollisionTree, a completed object

# A surface's skinning: vertex counts by influence, then a blend-weight token.
record XSurfaceVertexInfo 0x0C runtime=XSurfaceVertexInfo header=xanim/xanim.h copy=scalars
    0x00 vertCount            i16[4]
    0x08 vertsBlend           pointer  # blend records, 16-bit, in block 4

record XSurface 0x38 runtime=XSurface header=xanim/xanim.h copy=scalars
    0x00 tileMode             u8
    0x01 deformed             bool
    0x02 vertCount            u16
    0x04 triCount             u16
    0x06 zoneHandle           u8
    0x08 baseTriIndex         u16
    0x0A baseVertIndex        u16
    0x0C triIndices           pointer  # 3 x triCount 16-bit indices in block 8
    0x10 vertInfo             struct   of=XSurfaceVertexInfo
    0x1C verts0               pointer  # vertCount 32-byte vertices in block 7
    0x20 vertListCount        u32
    0x24 vertList             pointer  # XRigidVertList, a completed array
    0x28 partBits             i32[4]

# A collision surface: its triangles (48 bytes each, no pointer) follow the
# surfaces 4-aligned in block 4 and keep their layout.
record XModelCollSurf 0x2C runtime=XModelCollSurf_s header=xanim/xmodel.h copy=scalars
    0x00 collTris             pointer
    0x04 numCollTris          i32
    0x08 mins                 f32[3]
    0x14 maxs                 f32[3]
    0x20 boneIdx              i32
    0x24 contents             i32
    0x28 surfFlags            i32

# Physics geometry: a list of geoms, each a box, cylinder or brush. A brush's
# planes and adjacency hold no pointer and stay in block 4; its sides name
# their planes, which follow the sides.
record CBrushSide 0x0C runtime=cbrushside_t header=xanim/xanim.h copy=scalars
    0x00 plane                    pointer  # a plane token, resolved after the planes load
    0x04 materialNum              u32
    0x08 firstAdjacentSideOffset  i16
    0x0A edgeCount                u8

record BrushWrapper 0x50 runtime=BrushWrapper header=physics/phys_local.h copy=scalars
    0x00 mins                     f32[3]
    0x0C contents                 i32
    0x10 maxs                     f32[3]
    0x1C numsides                 u32
    0x20 sides                    pointer
    0x24 axialMaterialNum         i16[2][3]
    0x30 baseAdjacentSide         pointer
    0x34 firstAdjacentSideOffsets i16[2][3]
    0x40 edgeCount                u8[2][3]
    0x48 totalEdgeCount           i32
    0x4C planes                   pointer

record PhysGeomInfo 0x44 runtime=PhysGeomInfo header=physics/phys_local.h copy=scalars
    0x00 brush                    pointer  # BrushWrapper, a completed object
    0x04 type                     i32
    0x08 orientation              f32[3][3]
    0x2C offset                   f32[3]
    0x38 halfLengths              f32[3]

record PhysGeomList 0x2C runtime=PhysGeomList header=physics/phys_local.h copy=scalars
    0x00 count                    u32
    0x04 geoms                    pointer
    0x08 mass.centerOfMass        f32[3]
    0x14 mass.momentsOfInertia    f32[3]
    0x20 mass.productsOfInertia   f32[3]

record XModel 0xDC runtime=XModel header=xanim/xmodel.h copy=scalars
    asset member=model pool=Load_XModelAsset kind=XModel alias=inserted body=custom label=model
    0x00 name                 xstring
    0x04 numBones             u8
    0x05 numRootBones         u8
    0x06 numsurfs             u8
    0x07 lodRampType          u8
    0x08 boneNames            pointer  # numBones script strings
    0x0C parentList           pointer  # one byte per non-root bone
    0x10 quats                pointer  # four 16-bit values per non-root bone
    0x14 trans                pointer  # four floats per non-root bone
    0x18 partClassification   pointer  # one byte per bone
    0x1C baseMat              pointer  # one DObjAnimMat per bone
    0x20 surfs                pointer  # numsurfs XSurface
    0x24 materialHandles      pointer  # numsurfs Material tokens
    0x28 lodInfo              struct[4] of=XModelLodInfo
    0x98 collSurfs            pointer  # numCollSurfs XModelCollSurf_s
    0x9C numCollSurfs         i32
    0xA0 contents             i32
    0xA4 boneInfo             pointer  # one XBoneInfo per bone
    0xA8 radius               f32
    0xAC mins                 f32[3]
    0xB8 maxs                 f32[3]
    0xC4 numLods              i16
    0xC6 collLod              i16
    0xC8 streamInfo           pad[4]  # an empty struct and its padding
    0xCC memUsage             i32
    0xD0 flags                u8
    0xD1 bad                  bool
    0xD4 physPreset           pointer  asset=PhysPreset
    0xD8 physGeoms            pointer  # PhysGeomList, a completed object
