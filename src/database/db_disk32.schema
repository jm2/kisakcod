# Retail fast-file record layouts (docs/design/FASTFILE_LOADER.md, "Design").
# A retail .ff stores every record in its 32-bit (ILP32) layout. Each record is
# described here once; scripts/gen_disk32.py turns this file into the disk32
# mirror structs at build time. Generated code is never committed (AGENTS.md
# rule 8).
#
#   record <Name> <retail size> runtime=<native struct> header=<its header> [same=<disk32:: constant>]
#       <retail offset> <field> <kind> [count=<expression>]
#
# Kinds: i32 u32 f32 u8 (scalars), bool (one byte; nonzero is true),
# xstring (a C string: inline or an offset token), bytes (inline bytes, count
# given), xstrings (a pointer array of C strings, count given).
# The offsets and sizes are the retail facts: the generator checks them
# against the ILP32 rules, and the compiler checks the emitted mirror against
# them (ONDISK_*) and the native struct against the same field list (RUNTIME_*).

record RawFile 0x0C runtime=RawFile header=xanim/xanim.h
    0x00 name        xstring
    0x04 len         i32
    0x08 buffer      bytes      count=len+1

record StringTable 0x10 runtime=StringTable header=universal/q_shared.h same=kStringTableBytes
    0x00 name        xstring
    0x04 columnCount i32
    0x08 rowCount    i32
    0x0C values      xstrings   count=columnCount*rowCount

record PhysPreset 0x2C runtime=PhysPreset header=xanim/xanim.h
    0x00 name                  xstring
    0x04 type                  i32
    0x08 mass                  f32
    0x0C bounce                f32
    0x10 friction              f32
    0x14 bulletForceScale      f32
    0x18 explosiveForceScale   f32
    0x1C sndAliasPrefix        xstring
    0x20 piecesSpreadFraction  f32
    0x24 piecesUpwardVelocity  f32
    0x28 tempDefaultToCylinder bool

record MapEnts 0x0C runtime=MapEnts header=xanim/xanim.h
    0x00 name           xstring
    0x04 entityString   bytes      count=numEntityChars
    0x08 numEntityChars i32
