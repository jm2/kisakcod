# Extract current production declarations/bodies; fail closed if a boundary moves.
function(kisakcod_renderer_enum_slice source begin end name)
    set(source "${SRC_DIR}/${source}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    file(READ "${source}" text)
    string(FIND "${text}" "${begin}" first)
    string(FIND "${text}" "${begin}" last_start REVERSE)
    if(first LESS 0 OR NOT first EQUAL last_start)
        message(FATAL_ERROR "Missing/ambiguous renderer contract start: ${begin}")
    endif()
    string(SUBSTRING "${text}" ${first} -1 body)
    string(FIND "${body}" "${end}" last)
    if(last LESS 1)
        message(FATAL_ERROR "Missing renderer contract end: ${end}")
    endif()
    string(LENGTH "${end}" end_length)
    math(EXPR length "${last} + ${end_length}")
    string(SUBSTRING "${body}" 0 ${length} body)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/renderer-enums/${name}.inc" "${body}\n")
endfunction()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/renderer-enums")
kisakcod_renderer_enum_slice(gfx_d3d/r_dvars.h "enum GfxAspectRatio" "\n};" aspect_enum)
