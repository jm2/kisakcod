# Compile the actual RHS from all 15 migrated draw/prepass sites. Only replace
# the context field with the test input; do not duplicate the selector logic.
set(selectors "using DepthSelector = GfxDepthRangeType (*)(int);\nconstexpr DepthSelector depthSelectors[] = {\n")
foreach(source IN ITEMS rb_backend.cpp rb_tess.cpp)
    set(source "${SRC_DIR}/gfx_d3d/${source}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    file(READ "${source}" text)
    string(REGEX MATCHALL "[A-Za-z]+\\.source->cameraView[ \t]*[?][^;\n]*" expressions "${text}")
    foreach(expression IN LISTS expressions)
        string(REGEX REPLACE "[A-Za-z]+\\.source->cameraView" "cameraView" expression "${expression}")
        string(APPEND selectors "+[](int cameraView) { return ${expression}; },\n")
    endforeach()
endforeach()
string(APPEND selectors "};\nstatic_assert(sizeof(depthSelectors) / sizeof(depthSelectors[0]) == 15);\n")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/renderer-enums/depth_selectors.inc" "${selectors}")
